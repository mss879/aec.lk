# -----------------------------------------------------------------------------
# Public site URL — drives canonical tags, Open Graph URLs, the sitemap and
# robots.txt. Set this per environment; a preview deployment that inherits the
# production value will emit canonicals pointing at production.
# No trailing slash.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.australianeducationcentre.com.au

# -----------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose to the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. NEVER prefix this with NEXT_PUBLIC_ and never
# import it into a Client Component. It bypasses Row Level Security and is used
# only for writing public form submissions and AI-agent inquiries server-side.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Shared secret for the inquiries intake API (POST /api/inquiries).
# Give this to the AI agent (or any external integration) and have it send the
# value as an `x-api-key` header. Leave blank to disable external intake.
# -----------------------------------------------------------------------------
INQUIRIES_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI API Key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Resend API Key (for transactional emails)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

